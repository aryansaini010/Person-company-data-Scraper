# Copy to .env and fill in. Never commit .env (it holds secrets).
# Linux/macOS: cp .env.example .env
# PowerShell: Copy-Item .env.example .env

# Tier-1 news API (free tier at https://newsapi.org/register). Removes the
# "Tier-1 news connector down" notice and adds full-text news reach.
NEWSAPI_KEY=
# Tier-1 GNews (https://gnews.io — 100 req/day free → ≤10 people/day at
# ~6-10 req/person). Quota-guarded + 24h cached. Different service from
# NewsAPI: never put a GNews key in NEWSAPI_KEY.
GNEWS_API_KEY=
GNEWS_DAILY_CAP=100
GNEWS_LANG=en
GNEWS_COUNTRY=

# Tier-1 enrichment (all free + legal, official APIs only — no scraping):
# - Wikidata: keyless, always on (person employer/position/education,
#   company industry/HQ/employees/founded/LEI). No key needed.
# - GLEIF registry proof: keyless, always on (legal name, jurisdiction,
#   LEI status, HQ — reached via the LEI on the Wikidata record).
#   No key needed.
# - Hunter company/person enrichment (free key at https://hunter.io —
#   free monthly credits). Unlocks once a homepage is probed (domain known).
HUNTER_API_KEY=
# Quota guard (cost control; 0 = unlimited). Usage is cached 30d so repeat
# briefs cost zero calls.
HUNTER_MONTHLY_CAP=25
# Set to 1 to disable all enrichment connectors (kill-switch, tests).
ENRICH_DISABLE=

# Open WebUI integration (server-side only — never exposed to browsers).
# Base URL of your Open WebUI instance + API key from Settings → Account.
# Adjust the port if yours differs (e.g. http://127.0.0.1:8081).
# Absent key = chat/RAG features report down loudly; briefs unaffected.
OPENWEBUI_BASE_URL=http://localhost:3000
OPENWEBUI_API_KEY=

# Tier-2 self-hosted breadth search. Start Docker Desktop, then:
#   docker compose up -d searxng
# then set:
SEARXNG_URL=http://localhost:8080
FIRECRAWL_URL=http://localhost:3002

# Buyer segment: media_ott (default, Zee5-class) or generic
PROSPECT_SEGMENT=media_ott

# Guardrails (§6.4): 0 = off
PROSPECT_DAILY_QUOTA=0
PROSPECT_DEADLINE_S=600
PROSPECT_CHAR_BUDGET=400000
# API request budget in seconds: every request settles inside it, returning
# a partial brief with an `incomplete` note on breach (never hangs).
PROSPECT_API_DEADLINE_S=210

# Verifier thresholds (calibrated on eval/gold.jsonl; see eval/calibrate.py).
# Support >=0.6, partial >=0.3. Negation guard stays OFF for token-F1
# (set to 1 only with an NLI/LLM scorer).
VERIFIER_SUPPORT_T=0.6
VERIFIER_PARTIAL_T=0.3
VERIFIER_NEGATION_GUARD=
# VERIFIER_LLM=1 enables the Ollama verifier; VERIFIER_SHADOW=1 (default with
# LLM on) logs LLM-vs-F1 comparisons without enforcing. Set SHADOW=0 to
# enforce LLM verdicts after shadow calibration.
VERIFIER_LLM=
VERIFIER_SHADOW=1

# Set to 1 to force plain-HTTP fetching (skip local Firecrawl render)
FIRECRAWL_DISABLE=

# Postgres (docker-compose): override default dev credentials in prod.
POSTGRES_DB=prospect_intel
POSTGRES_USER=prospect
POSTGRES_PASSWORD=prospect
# Optional Postgres URL (when set, store.py prefers it; else SQLite fallback).
DATABASE_URL=
# OpenSearch + MinIO (docker-compose data zone; SQLite/FS fallback when unset).
OPENSEARCH_URL=http://localhost:9200
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=prospect-snapshots

# Model backends (Ollama wired later; mocks until then).
# MODEL_BACKEND=mock (default) | ollama | vllm
MODEL_BACKEND=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_AGENT_MODEL=gpt-oss:20b
OLLAMA_UTILITY_MODEL=qwen2.5:7b
# Small pitch model (speed): prose over verified gists doesn't need 20b.
OLLAMA_PITCH_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=bge-m3
VLLM_BASE_URL=
VLLM_AGENT_MODEL=Qwen3-30B-A3B
# Planner budgets (hard caps: recall without runaway latency).
PLANNER_MAX_PER_CAT=5
PLANNER_MAX_ROUNDS=2
# Set to 1 to enable parallel planner fan-out (news/filings/jobs) in
# /research and /company-research. Off by default until Ollama is wired;
# deterministic diet/discovery path stays the default for offline tests.
PLANNER_ENABLE=
